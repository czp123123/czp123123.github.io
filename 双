<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>双色球号码选择器 (6+1)</title>
    <style>
        body {
            font-family: 'Microsoft YaHei', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            margin: 0;
            padding: 20px;
            min-height: 100vh;
        }
        .container {
            max-width: 920px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            overflow: hidden;
        }
        header {
            background: linear-gradient(to right, #e74c3c, #c0392b);
            color: white;
            text-align: center;
            padding: 30px 20px;
        }
        h1 {
            margin: 0;
            font-size: 34px;
        }
        .subtitle {
            font-size: 18px;
            margin-top: 10px;
            opacity: 0.95;
        }

        .section {
            padding: 28px 30px;
        }
        .red-area {
            background: #fff8f8;
            border-left: 8px solid #e74c3c;
        }
        .blue-area {
            background: #f0f8ff;
            border-left: 8px solid #3498db;
        }

        h2 {
            margin: 0 0 20px 0;
            font-size: 24px;
        }
        .red-title { color: #e74c3c; }
        .blue-title { color: #3498db; }

        .number-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(58px, 1fr));
            gap: 14px;
        }

        .number {
            width: 100%;
            aspect-ratio: 1 / 1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            font-weight: bold;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.25s ease;
            user-select: none;
            border: 3px solid #ddd;
            background: white;
        }

        .number:hover {
            transform: scale(1.12);
            z-index: 2;
        }

        .red-ball {
            color: #e74c3c;
            border-color: #e74c3c;
        }
        .red-ball.selected {
            background: #e74c3c;
            color: white;
            border-color: #e74c3c;
            box-shadow: 0 8px 16px rgba(231, 76, 60, 0.5);
        }

        .blue-ball {
            color: #3498db;
            border-color: #3498db;
        }
        .blue-ball.selected {
            background: #3498db;
            color: white;
            border-color: #3498db;
            box-shadow: 0 8px 16px rgba(52, 152, 219, 0.5);
        }

        .selected-area {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 16px;
            margin: 25px 30px;
            text-align: center;
            box-shadow: inset 0 2px 8px rgba(0,0,0,0.05);
        }

        .selected-display {
            font-size: 32px;
            font-weight: bold;
            letter-spacing: 12px;
            line-height: 1.5;
        }

        .red-display { color: #e74c3c; }
        .blue-display { color: #3498db; }

        .btn-group {
            display: flex;
            gap: 18px;
            justify-content: center;
            flex-wrap: wrap;
            margin: 20px 0 30px 0;
        }

        button {
            padding: 15px 36px;
            font-size: 18px;
            font-weight: bold;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-random {
            background: #e74c3c;
            color: white;
        }
        .btn-random:hover {
            background: #c0392b;
            transform: translateY(-3px);
        }

        .btn-clear {
            background: #7f8c8d;
            color: white;
        }
        .btn-clear:hover {
            background: #61696b;
        }

        .count {
            color: #666;
            font-size: 16px;
            margin-top: 6px;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: #95a5a6;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>双色球号码选择器</h1>
            <p class="subtitle">前区 01-33 选 6 个 + 后区 01-16 选 1 个</p >
        </header>

        <!-- 前区 -->
        <div class="section red-area">
            <h2 class="red-title">前区（红球） <span style="font-size:18px;">（已选 <span id="red-count">0</span>/6）</span></h2>
            <div class="number-grid" id="red-grid"></div>
        </div>

        <!-- 后区 -->
        <div class="section blue-area">
            <h2 class="blue-title">后区（蓝球） <span style="font-size:18px;">（已选 <span id="blue-count">0</span>/1）</span></h2>
            <div class="number-grid" id="blue-grid"></div>
        </div>

        <!-- 已选号码 -->
        <div class="section">
            <h2>已选号码</h2>
            <div class="selected-area">
                <div class="selected-display">
                    <span id="selected-red" class="red-display"></span>
                    <span id="selected-blue" class="blue-display"></span>
                </div>
            </div>

            <div class="btn-group">
                <button class="btn-random" onclick="randomSelect()">🎲 随机生成一注</button>
                <button class="btn-clear" onclick="clearAll()">清空所有选择</button>
            </div>
        </div>

        <footer>
            自定义彩票号码选择工具 © 2026
        </footer>
    </div>

    <script>
        let selectedRed = [];
        let selectedBlue = [];

        // 创建前区 01-33
        function createRedBalls() {
            const grid = document.getElementById('red-grid');
            grid.innerHTML = '';
            for (let i = 1; i <= 33; i++) {
                const num = i < 10 ? '0' + i : i;
                const ball = document.createElement('div');
                ball.className = 'number red-ball';
                ball.textContent = num;
                ball.dataset.value = i;
                ball.onclick = () => toggleRed(i, ball);
                grid.appendChild(ball);
            }
        }

        // 创建后区 01-16
        function createBlueBalls() {
            const grid = document.getElementById('blue-grid');
            grid.innerHTML = '';
            for (let i = 1; i <= 16; i++) {
                const num = i < 10 ? '0' + i : i;
                const ball = document.createElement('div');
                ball.className = 'number blue-ball';
                ball.textContent = num;
                ball.dataset.value = i;
                ball.onclick = () => toggleBlue(i, ball);
                grid.appendChild(ball);
            }
        }

        function toggleRed(num, element) {
            if (selectedRed.includes(num)) {
                selectedRed = selectedRed.filter(n => n !== num);
                element.classList.remove('selected');
            } else {
                if (selectedRed.length >= 6) {
                    alert('前区最多只能选择 6 个号码！');
                    return;
                }
                selectedRed.push(num);
                element.classList.add('selected');
            }
            updateDisplay();
        }

        function toggleBlue(num, element) {
            // 后区只能选1个，点击已选中的则取消
            if (selectedBlue.includes(num)) {
                selectedBlue = [];
                element.classList.remove('selected');
            } else {
                // 清空之前的后区选择
                document.querySelectorAll('#blue-grid .number').forEach(b => b.classList.remove('selected'));
                selectedBlue = [num];
                element.classList.add('selected');
            }
            updateDisplay();
        }

        function updateDisplay() {
            document.getElementById('red-count').textContent = selectedRed.length;
            document.getElementById('blue-count').textContent = selectedBlue.length;

            const sortedRed = [...selectedRed].sort((a, b) => a - b);
            const redStr = sortedRed.map(n => n < 10 ? '0' + n : n).join('  ');

            const blueStr = selectedBlue.length ? 
                (selectedBlue[0] < 10 ? '0' + selectedBlue[0] : selectedBlue[0]) : '';

            document.getElementById('selected-red').textContent = redStr ? redStr + '　' : '';
            document.getElementById('selected-blue').textContent = blueStr;
        }

        function randomSelect() {
            clearAll();

            // 随机选前区6个
            let redPool = Array.from({length: 33}, (_, i) => i + 1);
            selectedRed = [];
            for (let i = 0; i < 6; i++) {
                const idx = Math.floor(Math.random() * redPool.length);
                selectedRed.push(redPool[idx]);
                redPool.splice(idx, 1);
            }

            // 随机选后区1个
            const blueNum = Math.floor(Math.random() * 16) + 1;
            selectedBlue = [blueNum];

            highlightSelected();
            updateDisplay();
        }

        function highlightSelected() {
            document.querySelectorAll('#red-grid .number').forEach(ball => {
                const val = parseInt(ball.dataset.value);
                ball.classList.toggle('selected', selectedRed.includes(val));
            });

            document.querySelectorAll('#blue-grid .number').forEach(ball => {
                const val = parseInt(ball.dataset.value);
                ball.classList.toggle('selected', selectedBlue.includes(val));
            });
        }

        function clearAll() {
            selectedRed = [];
            selectedBlue = [];
            document.querySelectorAll('.number').forEach(ball => ball.classList.remove('selected'));
            updateDisplay();
        }

        // 初始化
        window.onload = function() {
            createRedBalls();
            createBlueBalls();
            updateDisplay();
        };
    </script>
</body>
</html>
